3.def encipher_scytale(plaintext, radius):
   
    plaintext = plaintext.replace(" ", "").upper()
    
    
    if len(plaintext) % radius != 0:
        padding_length = radius - (len(plaintext) % radius)
        plaintext += "X" * padding_length  
        
    num_cols = len(plaintext) // radius
    ciphertext = [""] * len(plaintext)
    
    
    for i, char in enumerate(plaintext):
        row = i % radius
        col = i // radius
        ciphertext[row * num_cols + col] = char
        
    return "".join(ciphertext)

def decipher_scytale(ciphertext, radius):
    num_cols = len(ciphertext) // radius
    plaintext = [""] * len(ciphertext)
    
    for i, char in enumerate(ciphertext):
        row = i // num_cols
        col = i % num_cols
        original_idx = col * radius + row
        plaintext[original_idx] = char
        
    return "".join(plaintext)
4.def clean_text(text):
    return "".join([char.upper() for char in text if char.isalpha()])

def get_shifts_from_date(date_str):
    
    return [int(char) for char in date_str if char.isdigit()]

def date_shift_encode(message, date_str):
    plaintext = clean_text(message)
    shifts = get_shifts_from_date(date_str)
    if not shifts:
        raise ValueError("Date string must contain numbers.")
        
    ciphertext = []
    for i, char in enumerate(plaintext):
        shift = shifts[i % len(shifts)]
        new_char = chr(((ord(char) - ord('A') + shift) % 26) + ord('A'))
        ciphertext.append(new_char)
    return "".join(ciphertext)

def date_shift_decode(ciphertext, date_str):
    shifts = get_shifts_from_date(date_str)
    plaintext = []
    for i, char in enumerate(ciphertext):
        shift = shifts[i % len(shifts)]
        new_char = chr(((ord(char) - ord('A') - shift) % 26) + ord('A'))
        plaintext.append(new_char)
    return "".join(plaintext)
5. import string

def build_keyword_alphabet(keyword):
    keyword = "".join(dict.fromkeys(keyword.upper().replace(" ", ""))) 
    standard_alphabet = string.ascii_uppercase
    
    
    remaining_letters = "".join([c for c in standard_alphabet if c not in keyword])
    return keyword + remaining_letters

def keyword_encode(message, keyword):
    plaintext = clean_text(message)
    cipher_alphabet = build_keyword_alphabet(keyword)
    standard_alphabet = string.ascii_uppercase
    
    translation_table = str.maketrans(standard_alphabet, cipher_alphabet)
    return plaintext.translate(translation_table)

def keyword_decode(ciphertext, keyword):
    cipher_alphabet = build_keyword_alphabet(keyword)
    standard_alphabet = string.ascii_uppercase
    
    translation_table = str.maketrans(cipher_alphabet, standard_alphabet)
    return ciphertext.translate(translation_table)




