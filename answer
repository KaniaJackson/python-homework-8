def generate_amortization_schedule(P0, r, k, N):
    """
    P0: Amount to finance (principal)
    r: Annual interest rate (as a decimal, e.g., 0.05 for 5%)
    k: Number of compounding periods per year
    N: Number of years
    """
    periodic_rate = r / k
    total_payments = k * N
    
   
    if periodic_rate == 0:
        payment = P0 / total_payments
    else:
        payment = P0 * (periodic_rate * (1 + periodic_rate)**total_payments) / ((1 + periodic_rate)**total_payments - 1)
        
    remaining_balance = P0
    
 
